    <Compile Include="AssemblyInfoRotator.cs" />
    <Compile Include="BleCanal.cs" />
    <Compile Include="BuscadorEquipos.cs" />
    <Compile Include="DeviceLink.cs" />
    <Compile Include="Firmware.cs" />
    <Compile Include="Textos.cs" />
